#!/usr/bin/env bash
# seance Codex CLI wrapper — intercepts `codex` invocations inside seance
# terminals and injects lifecycle hooks so seance can track session state.
set -euo pipefail

# ── Find the real codex binary, skipping our own directory ──────────────────

WRAPPER_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL_CODEX=""
IFS=: read -ra PATH_DIRS <<< "$PATH"
for dir in "${PATH_DIRS[@]}"; do
    [[ -z "$dir" ]] && continue
    resolved="$(cd "$dir" 2>/dev/null && pwd)" || continue
    [[ "$resolved" == "$WRAPPER_DIR" ]] && continue
    if [[ -x "$dir/codex" ]]; then
        REAL_CODEX="$dir/codex"
        break
    fi
done

if [[ -z "$REAL_CODEX" ]]; then
    echo "codex: command not found" >&2
    exit 127
fi

# ── Pass-through conditions ──────────────────────────────────────────────────

# Not inside seance
if [[ -z "${SEANCE_SURFACE_ID:-}" ]]; then
    exec "$REAL_CODEX" "$@"
fi

# Hooks explicitly disabled
if [[ "${SEANCE_CODEX_HOOKS_DISABLED:-}" == "1" ]]; then
    exec "$REAL_CODEX" "$@"
fi

# ── Pass-through subcommands ─────────────────────────────────────────────────

case "${1:-}" in
    mcp|login|logout|debug|sandbox|completion|mcp-server|app-server|features|apply|a|agents|plugin|remote-control|update|doctor|queue|archive|delete|migrate-rollouts|unarchive|cloud|exec-server|help|-h|--help|-V|--version)
        exec "$REAL_CODEX" "$@"
        ;;
esac

# Socket health check (0.75s timeout)
if ! timeout 0.75 seance ctl --socket "${SEANCE_SOCKET_PATH:-}" ping >/dev/null 2>&1; then
    exec "$REAL_CODEX" "$@"
fi

# ── Add hooks in the session config layer ──────────────────────────────────
# Keep the real CODEX_HOME: auth, history, plugins, and hook trust must persist.
# Codex merges these hooks with user/project hooks. Session-flag hook identities
# are stable across panes, so reviewing them once is enough. Keep pane IDs in
# the environment, never in the commands (which would invalidate their trust).

HOOK_ARGS=(--enable hooks)
while read -r event command; do
    HOOK_ARGS+=(-c "hooks.$event=[{hooks=[{type=\"command\",command=\"seance ctl codex-hook $command\",timeout=3}]}]")
done <<'HOOKEOF'
SessionStart session-start
SessionEnd session-end
UserPromptSubmit prompt-submit
PreToolUse pre-tool-use
PostToolUse post-tool-use
Stop stop
HOOKEOF

export SEANCE_CODEX_PID=$$

# ── Launch codex (no exec — wrapper must survive for cleanup) ───────────────
# Codex may not fire SessionEnd, including on startup failure. The EXIT trap
# also runs on nonzero exits under set -e; cleanup must not mask Codex's status.
trap 'timeout 3 seance ctl codex-hook session-end <<< "{}" >/dev/null 2>&1 || true' EXIT

rc=0
"$REAL_CODEX" "${HOOK_ARGS[@]}" "$@" || rc=$?
exit $rc
